# ─── Optional site password gate ───
# Production: set BOTH values; the app returns HTTP 503 if either is missing.
# Local dev: set BOTH to test /login; if unset, the app stays open.
#
# SITE_PASSWORD=your-shared-secret
# COOKIE_SECRET=long-random-string-use-openssl-rand-hex-32

SITE_PASSWORD=
COOKIE_SECRET=

# Multiplayer (optional): WebSocket URL for the dedicated game server (default ws://127.0.0.1:3333)
# NEXT_PUBLIC_MULTIPLAYER_WS_URL=wss://your-game-host.example.com
