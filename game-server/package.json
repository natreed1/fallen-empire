{
  "name": "fallen-empire-game-server",
  "private": true,
  "scripts": {
    "start": "tsx --tsconfig tsconfig.json src/index.ts",
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "verify-multiplayer-authority": "cd .. && NODE_PATH=game-server/node_modules game-server/node_modules/.bin/tsx --tsconfig game-server/tsconfig.json scripts/verify-multiplayer-authority.ts",
    "verify-site-auth": "cd .. && NODE_PATH=game-server/node_modules game-server/node_modules/.bin/tsx --tsconfig game-server/tsconfig.json scripts/verify-site-auth.ts",
    "verify-fog-of-war": "cd .. && NODE_PATH=game-server/node_modules game-server/node_modules/.bin/tsx --tsconfig game-server/tsconfig.json scripts/verify-fog-of-war.ts"
  },
  "dependencies": {
    "simplex-noise": "^4.0.1",
    "ws": "^8.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.14"
  }
}
